# Banco de dados PostgreSQL (opcional)
DATABASE_URL=postgres://user:password@localhost:5432/restaurant

# Redis para fila de impressao (opcional)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Impressora termica LAN/Wi-Fi (porta 9100 comum)
PRINTER_IP=
PRINTER_PORT=9100

# Impressora local USB/Windows (auto detecta qualquer impressora fisica)
PRINTER_NAME=auto

# Modo no Windows:
# auto  -> escolhe raw para impressoras termicas e text para driver comum
# raw   -> envia ESC/POS raw
# text  -> imprime via driver (Out-Printer)
PRINTER_MODE=auto
PRINTER_AUTO_DETECT=1

# Timeout para comandos PowerShell internos (ms)
PRINTER_PS_TIMEOUT_MS=15000

# PrintNode (opcional para servico cloud)
PRINTNODE_API_KEY=
PRINTNODE_PRINTER_ID=

# Gateway Pix (mock ativo no servidor atual)
PIX_GATEWAY_API_URL=https://www.asaas.com/api/v3
PIX_GATEWAY_API_KEY=
PIX_GATEWAY_BEARER_TOKEN=
PIX_GATEWAY_PROVIDER=asaas
PIX_GATEWAY_CREATE_PATH=/payments
PIX_GATEWAY_VERIFY_PATH=/payments/:reference
PIX_GATEWAY_MERCHANT_KEY=+5521965648765

# Configuracoes do sistema
PORT=3000
QUEUE_NAME=print-jobs
ENABLE_QUEUE=0
ALLOWED_ORIGIN=*
